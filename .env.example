# ====================================
# FILE NÀY LƯU API KEY (MẬT KHẨU)
# ====================================
# Cách dùng:
# 1. Copy file này thành .env (bỏ chữ .example)
# 2. Điền API key thật vào
# 3. KHÔNG BAO GIỜ chia sẻ file .env cho ai

# API key của Google Gemini
GEMINI_API_KEY=

# API key của OpenAI (lấy tại: https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# API key của Anthropic Claude (lấy tại: https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Webhook callback URL (n8n Long)
WEBHOOK_URL=http://localhost:5678/webhook/ai-agent-callback

# Notion Integration (tùy chọn kết nối trực tiếp)
NOTION_TOKEN=
NOTION_DATABASE_ID=
MASTER_DB_PROVIDER=notion

GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
WEBHOOK_V2_URL=http://127.0.0.1:5678/webhook/ai-agent-callback-v2
# Use the same token in Content Studio, n8n Header Auth and Automation.
WEBHOOK_V2_TOKEN=
VIDEO_REVIEW_API_URL=http://127.0.0.1:8000
PORT=8001
HOST=127.0.0.1
ENABLE_NGROK=0
