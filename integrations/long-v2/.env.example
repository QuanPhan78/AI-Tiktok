# Notion Credentials
NOTION_TOKEN=secret_your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here
# Required: a separate test database for v2 handoff
NOTION_V2_DATABASE_ID=your_notion_v2_database_id_here
MASTER_DB_PROVIDER=notion

# Telegram Bot Credentials (for Step 5 approval & alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here
TELEGRAM_AUTHORIZED_USER_IDS=your_telegram_user_id_here
# Same X-Content-Token as Content Studio and the n8n v2 credential
WEBHOOK_V2_TOKEN=

# TikTok Open API v2 Credentials (for Step 8 publish)
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
TIKTOK_REDIRECT_URI=https://your-ngrok-domain.ngrok-free.dev/api/v1/tiktok/callback
NOTION_TOKENS_DB_ID=your_notion_tokens_database_id_here
ENABLE_TIKTOK_SANDBOX_SIMULATION=false
